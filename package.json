{
  "name": "pulse-spotify-client",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source, non-commercial Spotify client built on official Web API & Web Playback SDK with BYO Client ID.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p packages/plugin-sdk/tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"packages/*/src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contracts": "vitest run src/api/__tests__/contracts.test.ts",
    "test:e2e": "playwright test",
    "smoke:live": "node --experimental-strip-types scripts/liveSmokeTest.ts",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@pulse/plugin-sdk": "*",
    "@tanstack/react-virtual": "^3.13.0",
    "dexie": "^4.0.11",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.1",
    "@tauri-apps/api": "^2.3.0",
    "@tauri-apps/cli": "^2.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "msw": "^2.7.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.0.5"
  }
}
